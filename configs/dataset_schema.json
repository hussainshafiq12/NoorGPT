{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NoorGPT_AtlasChat_Schema",
  "description": "Standardized schema for NoorGPT multi-dialect Pashto instruction-tuning and benchmark records strictly following Atlas-Chat (Paper 1) - No domain field",
  "type": "object",
  "required": ["dialect", "messages"],
  "additionalProperties": false,
  "properties": {
    "dialect": {
      "type": "string",
      "enum": ["afghan", "peshawari"],
      "description": "Regional variety of Pashto: afghan ('Awani') or peshawari ('Shaurian')"
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": ["user", "assistant"]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
